# MaNGOS WotLK - Environment Configuration
# Copy this file to .env and modify the values as needed
# Command: cp .env.example .env

# ============================================
# TIMEZONE
# ============================================
TZ=UTC
# Examples: America/New_York, Europe/Madrid, Asia/Tokyo, America/Los_Angeles

# ============================================
# MYSQL DATABASE CONFIGURATION
# ============================================
# IMPORTANT: Change these passwords in production!
MYSQL_ROOT_PASSWORD=mangos_root_password_change_me
MYSQL_USER=mangos
MYSQL_PASSWORD=mangos_password_change_me
MYSQL_DATABASE=mangos
MYSQL_PORT=3306

# ============================================
# DATABASE NAMES
# ============================================
REALMD_DB=realmd
WORLD_DB=mangos
CHARACTER_DB=characters

# ============================================
# REALMD CONFIGURATION (Authentication Server)
# ============================================
REALMD_PORT=3724

# ============================================
# MANGOSD CONFIGURATION (World Server)
# ============================================
MANGOSD_PORT=8085
SOAP_PORT=7878
REALM_ID=1

# ============================================
# OPTIONAL SERVICES
# ============================================
# phpMyAdmin - Web database management interface
# To enable: docker-compose --profile tools up -d
PHPMYADMIN_PORT=8080

# ============================================
# DOCKER BUILD CONFIGURATION
# ============================================
# Enable BuildKit for faster builds
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============================================
# PLATFORM SELECTION (Optional)
# ============================================
# Uncomment one of these to force a specific platform:
# DOCKER_DEFAULT_PLATFORM=linux/amd64
# DOCKER_DEFAULT_PLATFORM=linux/arm64

# ============================================
# ADVANCED CONFIGURATION
# ============================================
# These are typically fine with defaults, but can be customized:

# Compose project name (affects container and volume names)
# COMPOSE_PROJECT_NAME=mangos-wotlk

# Docker Compose file to use
# COMPOSE_FILE=docker-compose.yml
# For Windows: COMPOSE_FILE=docker-compose.windows.yml
